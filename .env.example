# ===================================================================
# SMART MACHINE MONITORING & IDLE DETECTION SYSTEM - CONFIGURATION
# ===================================================================

# Optional: Google Gemini API Key for LLM-based RAG explanation synthesis
# If left empty, the system automatically uses its built-in local deterministic RAG knowledge engine.
GEMINI_API_KEY=

# Optional: OpenAI API Key (alternative LLM provider)
OPENAI_API_KEY=

# LLM Provider Selection: "auto", "gemini", "openai", "local"
LLM_PROVIDER=auto

# LLM Model Name (e.g., gemini-2.5-flash, gpt-4o-mini)
LLM_MODEL=gemini-2.5-flash

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Pen Refill Work Station Physical Operating Parameters
# Objects <= 15.0 cm are evaluated as Tool/Workpiece Present. Objects > 15.0 cm trigger IDLE halt.
DISTANCE_PRESENT_THRESHOLD_CM=15.0

# Maximum file upload limit in bytes (Default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
